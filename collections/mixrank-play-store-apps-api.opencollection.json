{
  "opencollection": "1.0.0",
  "info": {
    "name": "MixRank Data Account Play Store Apps API",
    "version": "2"
  },
  "items": [
    {
      "info": {
        "name": "Play Store Apps",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get APK download details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mixrank.com/v2/json/{api_key}/playstore/apks/:package_name/:version_id",
            "params": [
              {
                "name": "package_name",
                "value": "",
                "type": "path",
                "description": "package_name identifier"
              },
              {
                "name": "version_id",
                "value": "",
                "type": "path",
                "description": "version_id identifier"
              }
            ]
          },
          "docs": "Get APK download details"
        },
        {
          "info": {
            "name": "List/search the Play Store app directory",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mixrank.com/v2/json/{api_key}/playstore/apps",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Results per page (varies by endpoint, typically 1-100)"
              },
              {
                "name": "sort_field",
                "value": "",
                "type": "query",
                "description": "Field to sort by"
              },
              {
                "name": "sort_order",
                "value": "",
                "type": "query",
                "description": "Sort direction"
              }
            ]
          },
          "docs": "List/search the Play Store app directory"
        },
        {
          "info": {
            "name": "Get a Play Store app overview",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mixrank.com/v2/json/{api_key}/playstore/apps/:pname",
            "params": [
              {
                "name": "pname",
                "value": "",
                "type": "path",
                "description": "pname identifier"
              }
            ]
          },
          "docs": "Get a Play Store app overview"
        },
