{
  "opencollection": "1.0.0",
  "info": {
    "name": "MixRank Data Account Play Store SDKs API",
    "version": "2"
  },
  "items": [
    {
      "info": {
        "name": "Play Store SDKs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List/search the Play Store SDK directory",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mixrank.com/v2/json/{api_key}/playstore/sdks",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Results per page (varies by endpoint, typically 1-100)"
              },
              {
                "name": "sort_field",
                "value": "",
                "type": "query",
                "description": "Field to sort by"
              },
              {
                "name": "sort_order",
                "value": "",
                "type": "query",
                "description": "Sort direction"
              }
            ]
          },
          "docs": "List/search the Play Store SDK directory"
        },
        {
          "info": {
            "name": "Get Play Store SDK overview",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mixrank.com/v2/json/{api_key}/playstore/sdks/:sdk_slug",
            "params": [
              {
                "name": "sdk_slug",
                "value": "",
                "type": "path",
                "description": "sdk_slug identifier"
              }
            ]
          },
          "docs": "Get Play Store SDK overview"
        },
