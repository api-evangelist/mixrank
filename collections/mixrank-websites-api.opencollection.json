{
  "opencollection": "1.0.0",
  "info": {
    "name": "MixRank Data Account Websites API",
    "version": "2"
  },
  "items": [
    {
      "info": {
        "name": "Websites",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List/search the website directory",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mixrank.com/v2/json/{api_key}/web/sites",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Results per page (varies by endpoint, typically 1-100)"
              },
              {
                "name": "sort_field",
                "value": "",
                "type": "query",
                "description": "Field to sort by"
              },
              {
                "name": "sort_order",
                "value": "",
                "type": "query",
                "description": "Sort direction"
              }
            ]
          },
          "docs": "List/search the website directory"
        },
        {
          "info": {
            "name": "Get a website overview",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mixrank.com/v2/json/{api_key}/web/sites/:domain",
            "params": [
              {
                "name": "domain",
                "value": "",
                "type": "path",
                "description": "domain identifier"
              }
            ]
          },
          "docs": "Get a website overview"
        },
        {
          "info": {
            "name": "Technology tags assigned to a website",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mixrank.com/v2/json/{api_key}/web/sites/:domain/tags",
            "params": [
              {
                "name": "domain",
                "value": "",
                "type": "path",
                "description": "domain identifier"
              }
            ]
          },
          "docs": "Technology tags assigned to a website"
        }
      ]
    }
  ],
  "bundled": true
}