            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mixrank.com/v2/json/{api_key}/appstore/ipa/:ipa_id",
            "params": [
              {
                "name": "ipa_id",
                "value": "",
                "type": "path",
                "description": "ipa_id identifier"
              }
            ]
          },
          "docs": "Get IPA download details"
        },
